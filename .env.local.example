# ─────────────────────────────────────────────
#  EchoMeet — Environment Variables
#  Copy this file to .env.local and fill in your keys
# ─────────────────────────────────────────────

# Groq API — get yours free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Supabase — get yours at https://supabase.com
# Used for saving meeting history (optional — app works without it)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# App URL (for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
